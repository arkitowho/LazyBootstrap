{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MediaUpdater 更新清单",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "operations"
  ],
  "properties": {
    "operations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/operation"
      }
    }
  },
  "$defs": {
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?![/\\\\])(?!.*(?:^|[/\\\\])\\.\\.(?:[/\\\\]|$))(?!.*[:<>\"|?*]).+$"
    },
    "sourcePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[sS][oO][uU][rR][cC][eE](?:[/\\\\].+)?$"
    },
    "namespaces": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "minLength": 1
      },
      "additionalProperties": {
        "type": "string",
        "minLength": 1
      }
    },
    "xmlEdit": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "action",
            "xpath",
            "value"
          ],
          "properties": {
            "action": {
              "const": "setValue"
            },
            "xpath": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            "value": {
              "type": "string"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "action",
            "xpath",
            "value",
            "name"
          ],
          "properties": {
            "action": {
              "const": "addAttribute"
            },
            "xpath": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            "value": {
              "type": "string"
            },
            "name": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "action",
            "xpath",
            "xml"
          ],
          "properties": {
            "action": {
              "const": "replaceElement"
            },
            "xpath": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            "xml": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "action",
            "xpath",
            "xml"
          ],
          "properties": {
            "action": {
              "const": "appendChild"
            },
            "xpath": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            "xml": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "action",
            "xpath",
            "xml"
          ],
          "properties": {
            "action": {
              "const": "insertBefore"
            },
            "xpath": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            "xml": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "action",
            "xpath",
            "xml"
          ],
          "properties": {
            "action": {
              "const": "insertAfter"
            },
            "xpath": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            "xml": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "action",
            "xpath"
          ],
          "properties": {
            "action": {
              "const": "remove"
            },
            "xpath": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            }
          }
        }
      ]
    },
    "operation": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "target",
            "source"
          ],
          "properties": {
            "type": {
              "const": "copy"
            },
            "target": {
              "$ref": "#/$defs/relativePath"
            },
            "source": {
              "$ref": "#/$defs/sourcePath"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "target",
            "source"
          ],
          "properties": {
            "type": {
              "const": "mirror"
            },
            "target": {
              "$ref": "#/$defs/relativePath"
            },
            "source": {
              "$ref": "#/$defs/sourcePath"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "target"
          ],
          "properties": {
            "type": {
              "const": "delete"
            },
            "target": {
              "$ref": "#/$defs/relativePath"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "target",
            "edits"
          ],
          "properties": {
            "type": {
              "const": "editXml"
            },
            "target": {
              "$ref": "#/$defs/relativePath"
            },
            "edits": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/$defs/xmlEdit"
              }
            },
            "encoding": {
              "enum": [
                "auto",
                "utf-8",
                "utf-16le",
                "utf-16be",
                "gbk",
                "shift-jis"
              ]
            },
            "namespaces": {
              "$ref": "#/$defs/namespaces"
            }
          }
        }
      ]
    }
  }
}
